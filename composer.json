{
	"name": "tjm/wiki-blog",
	"description": "Blog \"plugin\" for 'tjm/wiki-site'.  Blog from structured folder of markdown files.",
	"authors": [
		{
			"name": "Toby Mackenzie",
			"email": "public@tobymackenzie.com",
			"homepage": "https://www.tobymackenzie.com"
		}
	],
	"license": "0BSD",
	"autoload": {
		"psr-4": {
			"TJM\\WikiBlog\\": "src",
			"TJM\\WikiBlogBundle\\": "src"
